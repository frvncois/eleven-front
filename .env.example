# Where the content comes from. scripts/pull-content.mjs reads it at build time (prebuild),
# and next.config.ts allows this origin in the CSP and in images.remotePatterns.
# Local Strapi: http://localhost:1337 — production: the Strapi Cloud URL.
STRAPI_URL=http://localhost:1337

# Only needed if the Strapi content types stop being publicly readable.
# The Public role is granted read access at boot (eleven-back/src/index.ts), so this is normally blank.
# STRAPI_API_TOKEN=

# Where the site lives, and whether search engines may index it.
# Until launch the site stays noindex everywhere; see lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://elevensound.com
NEXT_PUBLIC_INDEXABLE=false
