# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-dev/
/.next-agent/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design exports (Figma PNGs live in Figma)
/design/*.png

# QA screenshots
/shots

# Local Netlify folder
.netlify

# Deno lockfile written by the Netlify CLI (edge functions)
deno.lock

# Raw Figma exports (masters, kept locally). The site ships the WebP/MP4 in public/images/figma
/design/exports
